{
  "name": "pitchmind",
  "version": "1.0.0",
  "description": "Agent-based 2D football match simulator with physics, tactical AI, xG and league mode",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
